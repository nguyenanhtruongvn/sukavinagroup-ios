{
	"appId": "net.sukavinagroup.portal",
	"appName": "Sukavina Portal",
	"webDir": "../../dist/apps/web",
	"backgroundColor": "#121116",
	"server": {
		"url": "https://sukavinagroup.net",
		"cleartext": false,
		"allowNavigation": [
			"sukavinagroup.net",
			"*.sukavinagroup.net"
		]
	},
	"ios": {
		"contentInset": "automatic",
		"preferredContentMode": "mobile",
		"scheme": "Sukavina",
		"limitsNavigationsToAppBoundDomains": true,
		"backgroundColor": "#121116"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1200,
			"launchAutoHide": true,
			"backgroundColor": "#121116",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#121116",
			"overlaysWebView": false
		},
		"Keyboard": {
			"resize": "native",
			"style": "dark",
			"resizeOnFullScreen": true
		}
	},
	"packageClassList": [
		"AppPlugin",
		"KeyboardPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
