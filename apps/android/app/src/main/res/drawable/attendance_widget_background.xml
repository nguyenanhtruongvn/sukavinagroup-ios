<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:centerColor="#FFFF7D12"
                android:endColor="#FFDB0B58"
                android:startColor="#FFFA2D42"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:endColor="#12FFFFFF"
                android:startColor="#3DFFFFFF"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#52FFFFFF" />
        </shape>
    </item>
</layer-list>
