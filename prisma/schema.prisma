generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContentItem {
  id          String   @id @default(cuid())
  page        String
  key         String
  title       String
  body        String
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([page, key])
}

model Employee {
  id                String   @id @default(cuid())
  employeeCode      String   @unique
  fullName          String
  jobTitle          String
  department        String
  managerEmployeeCode String?
  hireDate          DateTime?
  contractType      String?
  phoneNumber       String?  @unique
  gmailEmail        String?  @unique
  gmailVerified     Boolean  @default(false)
  emailVerificationCode String?
  emailVerificationExpiresAt DateTime?
  passwordChangeCode String?
  passwordChangeExpiresAt DateTime?
  passwordChangeRequestedAt DateTime?
  passwordChangedAt DateTime?
  passwordHash      String?
  authProvider      String   @default("phone_password")
  role              String   @default("Nhân viên")
  accountType       String   @default("EMPLOYEE")
  permissions       String[] @default([])
  protected         Boolean  @default(false)
  remainingLeaveDays Int     @default(0)
  attendanceStatus  String   @default("")
  payrollStatus     String   @default("")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  requests          EmployeeRequest[]
  passkeys          WebAuthnCredential[]
}

model WebAuthnCredential {
  id           String   @id
  employeeId   String
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[] @default([])
  deviceType   String
  backedUp     Boolean  @default(false)
  createdAt    DateTime @default(now())
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeRequest {
  id         String   @id @default(cuid())
  employeeId String
  kind       String
  startsAt   DateTime
  endsAt     DateTime
  reason     String
  status     String   @default("pending")
  managerEmployeeId String?
  managerEmployeeCode String?
  decisionNote String?
  decidedAt  DateTime?
  dueAt      DateTime
  autoApproved Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@index([status])
}

model UserNotification {
  id          String   @id @default(cuid())
  recipientId String
  type        String
  title       String
  message     String
  requestId   String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, read])
}

model AppLog {
  id        String   @id @default(cuid())
  level     String
  source    String
  message   String
  meta      String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AttendanceRecord {
  id               String   @id @default(cuid())
  userEnrollNumber String
  punchedAt        DateTime
  source           String
  originType       String?
  machineNo        Int      @default(0)
  attendanceDate   String
  createdAt        DateTime @default(now())

  @@unique([userEnrollNumber, punchedAt, machineNo])
  @@index([userEnrollNumber, punchedAt])
  @@index([userEnrollNumber, attendanceDate, punchedAt])
  @@index([attendanceDate])
}
